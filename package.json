{
  "name": "claude-desktop",
  "productName": "Claude Desktop",
  "version": "0.1.0",
  "description": "Claude Code CLI 的桌面 GUI 封装 —— 所有操作通过执行 claude 命令完成",
  "main": "./out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:win": "electron-vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
